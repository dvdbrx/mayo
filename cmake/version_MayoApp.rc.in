#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @Mayo_VersionMajor@,@Mayo_VersionMinor@,@Mayo_VersionPatch@,0
 PRODUCTVERSION @Mayo_VersionMajor@,@Mayo_VersionMinor@,@Mayo_VersionPatch@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "@CADVIEW_COMPANY_NAME@"
            VALUE "FileDescription",  "@CADVIEW_APP_DESCRIPTION@"
            VALUE "FileVersion",      "@Mayo_Version@"
            VALUE "InternalName",     "cadview"
            VALUE "OriginalFilename", "cadview.exe"
            VALUE "ProductName",      "@CADVIEW_PRODUCT_NAME@"
            VALUE "ProductVersion",   "@Mayo_Version@"
            VALUE "LegalCopyright",   "Copyright (c) 2026, @CADVIEW_COMPANY_NAME@"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END